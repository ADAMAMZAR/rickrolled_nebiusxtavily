# NVIDIA Nemotron on Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Reads investigation screenshots only (no Nemotron model on Token Factory takes images)
NEBIUS_VISION_MODEL=google/gemma-3-27b-it

# Hermes API server. HERMES_API_KEY is filled in by: python scripts/setup_hermes.py
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=

# Telegram (optional). Token from @BotFather; your numeric user id from @userinfobot.
# Copied into the Hermes profile by: python scripts/setup_hermes.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Tavily (optional): web watch and lookup. Free key at tavily.com
TAVILY_API_KEY=

# Google (optional): OAuth "Desktop app" client file from Google Cloud. See README: Google setup
GOOGLE_CLIENT_SECRET_FILE=./data/client_secret.json
# How many days back the first email sync reads
SYNC_LOOKBACK_DAYS=7

# App
# Base URL of the dashboard, used in chat links. Change it on a server.
PUBLIC_URL=http://127.0.0.1:8000
# Set on a public server: the dashboard and /api then ask for this password (any username).
APP_PASSWORD=
TIMEZONE=Asia/Kuala_Lumpur
STALE_DAYS=4
DATABASE_URL=sqlite:///./data/continuum.db
LOG_LEVEL=INFO
