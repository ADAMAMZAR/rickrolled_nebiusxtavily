# Which LLM to use: nebius (real target, Nemotron) or deepseek (dev stand-in)
LLM_PROVIDER=nebius

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# DeepSeek (only while waiting for a Nebius key)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Hermes API server. HERMES_API_KEY is filled in by: python scripts/setup_hermes.py
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=

# Telegram (optional). Token from @BotFather; your numeric user id from @userinfobot.
# Copied into the Hermes profile by: python scripts/setup_hermes.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# App
TIMEZONE=Asia/Kuala_Lumpur
STALE_DAYS=4
DATABASE_URL=sqlite:///./data/continuum.db
LOG_LEVEL=INFO
